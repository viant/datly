(* Datly-specific grammar plus explicitly delegated host languages.
   Whitespace/comments are allowed between tokens unless a line directive says otherwise.
   Arity/type/uniqueness rules are in dql-grammar.md. *)
document = {package_line | import_line | setting | declaration | query | comment} ;
package_line = "#package", "(", string, ")", line_end ;
import_line = "#import", "(", string, ",", string, ")", line_end ;
setting = "#setting", "(", assignment_prefix, setting_call, ")" ;
assignment_prefix = "$_", "=" ;
setting_call = "$", setting_name, arguments, {".", cache_option, arguments} ;
setting_name = "route" | "api_key" | "connector"
 | "input_type" | "output_type" | "dest" | "input_dest" | "output_dest"
 | "router_dest" | "meta" | "mcp" | "report" | "cube" | "cubeCompose"
 | "cache" | "cache_warmup" | "marshal" | "unmarshal" | "format"
 | "date_format" | "case_format" | "ignoreEmptyQueryParameters"
 | "output_exclude" | "output_omit_empty" | "output_title" | "const"
 | "DocGlobalURLs" | "DocURLs" | "DocURL" | "DocBaseURL"
 | "static_resource" | "static_content" | "mcp_folder" ;
cache_option = "WithProvider" | "WithLocation" | "WithTimeToLiveMs" ;
declaration = "#define", "(", assignment_prefix, "$", parameter_name,
 [type_annotation], [binding], {declaration_option}, [declaration_query], ")" ;
type_annotation = "<", ("?" | go_type), [",", go_type], ">" ;
binding = "(", provider_kind, "/", location, ")" ;
provider_kind = identifier ;
location = ? provider location text, possibly empty, up to matching ')' ? ;
declaration_option = ".", option_name, arguments ;
option_name = "Required" | "Optional" | "WithType" | "WithTag" | "Tag"
 | "WithCodec" | "WithStatusCode" | "WithErrorMessage" | "Cacheable"
 | "QuerySelector" | "WithPredicate" | "Predicate" | "ApplyWhenAbsentPredicate"
 | "When" | "Scope" | "Of" | "Value" | "Embed" | "Cardinality" | "Async"
 | "Output" | "WithURI" | "WithMCP" | "WithPathMCP"
 | "MinAllowedRecords" | "MaxAllowedRecords" | "ExpectedReturned"
 | "WithConnector" | "Connector" | "WithTypeName" | "TypeName" | "Type"
 | "WithDest" | "Dest" | "WithCache" | "WithLimit"
 | "WithColumnType" | "ColumnType" | "WithColumnTag" | "ColumnTag"
 | "WithColumnGroupable" | "ColumnGroupable" ;
declaration_query = "/*", declaration_sql, "*/" ;
declaration_sql = sql_query | structql_query ;
structql_query = ? StructQL SELECT over a declared Go data path ? ;
query = sql_query, [";"] ;
sql_query = [with_clause], select_core, {set_operation, select_core},
 [order_clause], [window_clause], [limit_clause], [offset_clause] ;
with_clause = "WITH", ["RECURSIVE"], cte, {",", cte} ;
cte = sql_identifier, [column_names], "AS", "(", sql_query, ")" ;
column_names = "(", sql_identifier, {",", sql_identifier}, ")" ;
select_core = "SELECT", ["DISTINCT" | "ALL"], projection, {",", projection},
 ["FROM", table_source, {join_clause}], ["WHERE", sql_expression],
 ["GROUP BY", expression_list], ["HAVING", sql_expression] ;
projection = star_projection | view_control | rich_type_declaration
 | column_tag_declaration | sql_expression, [sql_alias] ;
star_projection = [sql_identifier, "."], "*", ["EXCEPT", identifier_list] ;
table_source = sql_identifier, [sql_alias] | "(", sql_query, ")", [sql_alias]
 | "(", sql_identifier, ")", [sql_alias] | embedded_sql, [sql_alias]
 | ? supported dialect table expression ? ;
join_clause = [join_kind], "JOIN", table_source,
 [("ON", sql_expression) | ("USING", column_names)] ;
join_kind = "INNER" | "LEFT", ["OUTER"] | "RIGHT", ["OUTER"]
 | "FULL", ["OUTER"] | "CROSS" ;
set_operation = "UNION", ["ALL" | "DISTINCT"] | ? dialect set operator ? ;
order_clause = "ORDER BY", order_item, {",", order_item} ;
order_item = sql_expression, ["ASC" | "DESC"], ["NULLS FIRST" | "NULLS LAST"] ;
window_clause = ? dialect WINDOW clause ? ;
limit_clause = "LIMIT", sql_expression, [",", sql_expression] ;
offset_clause = "OFFSET", sql_expression ;
sql_alias = ["AS"], sql_identifier ;
expression_list = sql_expression, {",", sql_expression} ;
identifier_list = sql_identifier, {",", sql_identifier} ;
sql_expression = ? SQLparser/dialect expression: literals, identifiers, bound parameters,
 operators, predicates, CASE, functions, CAST, windows and subqueries;
 declared input values and fixed query-context operators preserve bound arguments ? ;
view_control = control_name, "(", identifier, {",", control_argument}, ")" ;
control_name = "use_connector" | "use_cache" | "cache_warmup" | "order_by"
 | "set_limit" | "allow_nulls" | "groupable" | "grouping_enabled"
 | "allowed_order_by_columns" | "cardinality" | "self_ref" | "type" | "dest"
 | "batch_size" | "batch_concurrency" | "relational_concurrency"
 | "publish_parent" | "set_partitioner" | "match_strategy" | "entity_hooks" ;
control_argument = string | integer | identifier ;
rich_type_declaration = "CAST", "(", column_ref, "AS", go_type, ")" ;
column_tag_declaration = "tag", "(", column_ref, ",", string, ")" ;
column_ref = identifier, ".", sql_identifier ;
embedded_sql = "$", "{embed:", resource_reference, "}" ;
resource_reference = ? fs resource path, optionally namespace:path ? ;
bound_parameter = ":", identifier, {".", identifier} ;
input_reference = "$", identifier, {".", identifier} ;
query_context = ? fixed View pagination references and CubeSQL frame references ? ;
declaration_value = input_reference | ? supported declarative provider/activation value ? ;
go_type = ? Go type expression using declared package aliases: named type, pointer,
 slice, array, map, struct, interface, function/channel or generic instantiation;
 component suitability is a semantic check ? ;
arguments = "(", [argument, {",", argument}], ")" ;
argument = string | integer | boolean | go_type | declaration_value ;
parameter_name = letter, {letter | digit | "_"} ;
identifier = (letter | "_"), {letter | digit | "_"} ;
sql_identifier = identifier, {".", identifier} | ? dialect-quoted identifier ? ;
integer = ["-"], digit, {digit} ;
boolean = "true" | "false" ;
string = ? balanced single- or double-quoted DQL argument ? ;
comment = ? SQL line or balanced block comment ? ;
letter = ? ASCII A-Z or a-z ? ;
digit = ? ASCII 0-9 ? ;
line_end = ? newline or end of input ? ;
